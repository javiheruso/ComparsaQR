generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoVinculacion {
  socio
  hijos_mayores
  socios_menores
  hijo_socio
}

enum EstadoPulsera {
  activa
  inactiva
  perdida
}

enum TipoTransaccion {
  carga
  consumo
  devolucion
}

enum PermisoPunto {
  barra
  caja
}

model PuntoVenta {
  id        Int          @id @default(autoincrement())
  nombre    String       @unique
  password  String
  permiso   PermisoPunto
  activo    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  transacciones Transaccion[]
}

model Socio {
  id               Int              @id @default(autoincrement())
  numeroSocio      String           @unique
  dni              String?          @unique
  nombre           String
  apellido1        String?
  apellido2        String?
  tipoVinculacion  TipoVinculacion  @default(socio)
  fechaNacimiento  DateTime?
  credito              Decimal          @default(0) @db.Decimal(12, 2)
  creditoNoRetornable  Decimal          @default(0) @db.Decimal(12, 2)
  estadoPulsera        EstadoPulsera    @default(activa)
  qrToken          String           @unique @default(uuid())
  filada           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  transacciones    Transaccion[]
  qrTokenAudits    QrTokenAudit[]

  @@index([nombre])
  @@index([apellido1])
  @@index([apellido2])
  @@index([numeroSocio])
}

model QrTokenAudit {
  id         Int      @id @default(autoincrement())
  socioId     Int
  socio       Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)
  action      String
  oldQrToken  String
  newQrToken  String?
  actor       String?
  createdAt   DateTime @default(now())

  @@index([socioId, createdAt])
}

model Producto {
  id        Int      @id @default(autoincrement())
  nombre    String
  precio    Decimal  @db.Decimal(12, 2)
  imagen    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Heartbeat {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  timestamp DateTime @default(now())
}

model RateLimit {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model GuestSession {
  id           Int       @id @default(autoincrement())
  balance      Decimal   @default(100) @db.Decimal(12, 2)
  lastChargeAt DateTime?
  updatedAt    DateTime  @updatedAt
}

model Transaccion {
  id           Int              @id @default(autoincrement())
  socioId      Int
  socio        Socio            @relation(fields: [socioId], references: [id], onDelete: Cascade)
  tipo         TipoTransaccion
  cantidad     Decimal          @db.Decimal(12, 2)
  descripcion  String?
  operador     String?
  puntoVentaId Int?
  puntoVenta   PuntoVenta?      @relation(fields: [puntoVentaId], references: [id])
  createdAt    DateTime         @default(now())
}

model IdempotencyRecord {
  id           Int      @id @default(autoincrement())
  scope        String
  key          String
  requestHash  String
  status       String
  responseCode Int?
  responseBody Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scope, key])
  @@index([scope, createdAt])
}
